{
  "name": "agent-control",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained starter for agent workflow, bounded loops, verification, and handoff discipline.",
  "type": "module",
  "bin": {
    "agent-control": "scripts/agent-control.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:agent-control && npm test && npm run preflight",
    "check:agent-control": "node scripts/check-agent-control-authority.mjs",
    "check:reusable": "node scripts/check-reusable-install.mjs",
    "agent-control": "node scripts/agent-control.mjs",
    "preflight": "node scripts/agent-control.mjs preflight --file templates/project-memory.md",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "agents",
    "workflow",
    "loops",
    "verification",
    "handoff"
  ]
}
