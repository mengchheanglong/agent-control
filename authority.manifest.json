{
  "schemaVersion": 1,
  "name": "agent-control",
  "purpose": "Self-contained operating surface for bounded agent workflow, verification discipline, stop-lines, logging, and handoff quality.",
  "authorityOrder": [
    "README.md",
    "implement.md",
    "runbook/active.md",
    "runbook/current-priority.md",
    "policies/stop-lines.md",
    "policies/continuation-rules.md",
    "policies/logging-rules.md"
  ],
  "surfaces": {
    "entrypoints": [
      "AGENTS.md",
      "README.md",
      "implement.md",
      "package.json"
    ],
    "runbook": [
      "runbook/active.md",
      "runbook/current-priority.md"
    ],
    "policies": [
      "policies/stop-lines.md",
      "policies/continuation-rules.md",
      "policies/logging-rules.md",
      "policies/stop-line-cards.json"
    ],
    "templates": [
      "templates/cycle-entry.md",
      "templates/loop-run.md",
      "templates/handoff.md",
      "templates/project-memory.md"
    ],
    "tools": [
      "scripts/agent-control.mjs",
      "scripts/lib/agent-control-core.mjs",
      "scripts/lib/memory-core.mjs",
      "scripts/check-agent-control-authority.mjs",
      "scripts/check-reusable-install.mjs"
    ],
    "tests": [
      "tests/agent-control.test.mjs"
    ],
    "memory": [
      "memory/README.md"
    ],
    "logs": [
      "logs/README.md"
    ]
  },
  "requiredCommands": [
    "npm run check",
    "npm run check:agent-control",
    "npm run check:reusable",
    "npm test",
    "npm run preflight",
    "npm run agent-control -- help",
    "npm run agent-control -- adoption-protocol",
    "npm run agent-control -- preflight --file templates/project-memory.md",
    "npm run agent-control -- audit-memory --file templates/project-memory.md",
    "npm run agent-control -- score-next --file templates/project-memory.md",
    "npm run agent-control -- render-stop-lines --check",
    "npm run agent-control -- analyze-logs",
    "npm run agent-control -- show-next --file templates/project-memory.md"
  ],
  "forbiddenDrift": [
    "sibling workspace required as the default root",
    "hidden home-directory workspace layout required",
    "archived logs treated as active doctrine",
    "numeric continuation quota",
    "unbounded autonomous execution"
  ]
}
